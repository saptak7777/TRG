{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TRG-64 / SINC",
  "scopeName": "source.trg",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.trg",
          "match": "//.*$"
        },
        {
          "name": "comment.block.trg",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.trg",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.trg",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.trg",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.trg",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.trg",
          "match": "\\\\b(fn|extern|import|loop|ret|const|if|else|artifact|deps|suite|driver)\\\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.other.trg",
          "match": "\\\\b[A-Z][A-Z0-9_]+\\\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.trg",
          "match": "\\\\b0x[0-9a-fA-F]+\\\\b"
        },
        {
          "name": "constant.numeric.decimal.trg",
          "match": "\\\\b[0-9]+\\\\b"
        },
        {
          "name": "constant.numeric.devanagari.trg",
          "match": "[०-९]+"
        },
        {
          "name": "constant.numeric.bengali.trg",
          "match": "[০-৯]+"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "([a-zA-Z_\\u0600-\\u06FF\\u0900-\\u09FF\\u0B80-\\u0BFF][a-zA-Z0-9_\\u0600-\\u06FF\\u0900-\\u09FF\\u0B80-\\u0BFF]*)!\\\\s*(\\\\(|\\\\[)",
          "captures": {
            "1": {
              "name": "entity.name.function.impure.trg"
            }
          }
        },
        {
          "match": "([a-zA-Z_\\u0600-\\u06FF\\u0900-\\u09FF\\u0B80-\\u0BFF][a-zA-Z0-9_\\u0600-\\u06FF\\u0900-\\u09FF\\u0B80-\\u0BFF]*)\\\\s*(\\\\(|\\\\[)",
          "captures": {
            "1": {
              "name": "entity.name.function.trg"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.trg",
          "match": "(\\+|-|\\*|/|%|\\^|\\||&|~|==|!=|<=|>=|<|>|=|!|@|:)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.multilingual.trg",
          "match": "[\\u0600-\\u06FF\\u0900-\\u09FF\\u0B80-\\u0BFF]+"
        },
        {
          "name": "variable.other.trg",
          "match": "\\\\b[a-zA-Z_][a-zA-Z0-9_]*\\\\b"
        }
      ]
    }
  }
}